    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:docker": "scripts/e2e-docker.sh",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "bump-lexical": "node scripts/bump-lexical.mjs",
    "prepare": "husky"
  },
