    "lexical": "https://pkg.pr.new/facebook/lexical/lexical@e240f42c712c828a1eaecbb12f8ca4dbd21faf56",
    "lib0": "1.0.0-rc.36",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
