{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jot",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-25",
  // Workers Builds deploys `main` and every other branch as a Preview (D10).
  // The account is the one the Worker is connected to; never put its id here.
  "routes": [{ "pattern": "jot.rovira.sh", "custom_domain": true }],
  // Production answers only on jot.rovira.sh. Each Preview answers on workers.dev at
  // <preview-name>-jot.rovira.workers.dev, which Cloudflare marks noindex (D24).
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    // Unknown paths fall back to index.html; the client router decides.
    "not_found_handling": "single-page-application",
    // The Worker validates note ids before anything is served (D02).
    "run_worker_first": ["/api/*", "/n/*"],
  },
  // One SQLite-backed Durable Object per note (D01).
  "durable_objects": {
    "bindings": [{ "name": "NOTES", "class_name": "NoteRoom" }],
  },
  // Migrations stay at the top level; every Preview runs them into its own namespace.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NoteRoom"] }],
  "observability": { "enabled": true },
  "vars": { "JOT_ENV": "production" },
  // Preview settings (D10). Previews inherit none of the above except assets,
  // compatibility, migrations and observability, so the binding and vars are
  // repeated here. Each Preview gets its own Durable Object namespace: never add
  // a `script_name`, which would reach production's notes. No routes or crons:
  // those always target production.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "NOTES", "class_name": "NoteRoom" }],
    },
    // The Worker marks every response noindex when it runs as a Preview.
    "vars": { "JOT_ENV": "preview" },
  },
}
