{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jot",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-25",
  // The account comes from CLOUDFLARE_ACCOUNT_ID (CI secret), never this file.
  "routes": [{ "pattern": "jot.rovira.sh", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    // Unknown paths fall back to index.html; the client router decides.
    "not_found_handling": "single-page-application",
    // The Worker validates note ids before anything is served (D02).
    "run_worker_first": ["/api/*", "/n/*"],
  },
  // One SQLite-backed Durable Object per note (D01).
  "durable_objects": {
    "bindings": [{ "name": "NOTES", "class_name": "NoteRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NoteRoom"] }],
  "observability": { "enabled": true },
  "env": {
    // PR previews (D10). CI builds with CLOUDFLARE_ENV=preview, then
    // scripts/preview-config.mjs writes the config it deploys as jot-pr-<n> on
    // workers.dev, and refuses anything below it does not expect. Routes are
    // inheritable, so `routes: []` keeps a preview off jot.rovira.sh. Its own
    // binding and migration give it its own Durable Object namespace: never add
    // a `script_name` or a transferred class, which would reach production.
    "preview": {
      "name": "jot-preview",
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [{ "name": "NOTES", "class_name": "NoteRoom" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NoteRoom"] }],
    },
  },
}
